//
// Moto gestures for kyoto: chop chop flashlight, peek wake, double tap to wake.
//

android_app {
    name: "KyotoActions",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-kyoto-actions"],
}

prebuilt_etc {
    name: "privapp-permissions-kyoto-actions",
    src: "privapp-permissions-kyoto-actions.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
