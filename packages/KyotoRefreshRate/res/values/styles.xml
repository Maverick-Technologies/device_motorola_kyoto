<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault picks up the system Material You colors and follows dark mode. -->
    <style name="Theme.RefreshRate" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/page_background</item>
    </style>

    <style name="RefreshRate" />

    <style name="RefreshRate.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RefreshRate.Radio">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="RefreshRate.RowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">google-sans</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="RefreshRate.RowSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">google-sans-text</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Led" />

    <style name="Led.Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">google-sans-text-medium</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
</resources>
