android_app {
    name: "KyotoRefreshRate",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-kyoto-refreshrate"],
}

prebuilt_etc {
    name: "privapp-permissions-kyoto-refreshrate",
    src: "privapp-permissions-kyoto-refreshrate.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
