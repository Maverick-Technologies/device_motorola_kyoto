#
# kyoto fixes for running Android 15 on the stock Android 13 (FCM 5) vendor.
#

on post-fs-data
    # Vendor build.prop sets debug.renderengine.backend=skiagl (non-threaded). On Android 15
    # SurfaceFlinger then defers screenshot composition until after the RenderArea is freed:
    # SIGSEGV in createScreenCaptureOutput, UI restart loop at the lock screen.
    setprop debug.renderengine.backend skiaglthreaded

# FocalTech touch gesture mode is off unless Moto software enables it; without it the
# dt-gesture (double tap) sensor never fires. KyotoActions handles the wake.
on boot
    write /sys/devices/platform/11d01000.i2c7/i2c-7/7-0038/fts_gesture_mode 1

# Vendor android.hardware.nfc@1.2-service.rc only starts the NXP HAL when
# ro.build.version.release=13. Same triggers, without the version gate.
# FM radio: Motorola FMRadioService (platform_app, allowed fm_device by the vendor policy) opens
# /dev/fm itself; the vendor creates it media:media 0660 when the MT6631 driver loads.
on property:sys.boot_completed=1
    chmod 0666 /dev/fm

on boot && property:ro.vendor.hw.nfc=nxp
    start vendor.nfc_hal_service

on boot && property:ro.vendor.hw.nfc=ese_nxp
    start vendor.nfc_hal_service

on boot && property:ro.vendor.hw.nfc=true
    start vendor.nfc_hal_service

# Notification light (KyotoRefreshRate): the single LED above the display is MT6360 channel 1,
# /sys/class/leds/charging. Both patterns use the MT6360 breath engine; its timing nodes
# (list_time selectors: 0 = 0.125 s, +0.25 s per step) exist only while breath_mode is the
# trigger, so they are written after selecting it.
on property:sys.kyoto.led=off
    write /sys/class/leds/charging/trigger none
    write /sys/class/leds/charging/brightness 0

# Pulse: 0.75 s fade in, 0.375 s on, 0.75 s fade out, 0.375 s off
on property:sys.kyoto.led=pulse_1
    write /sys/class/leds/charging/trigger none
    write /sys/class/leds/charging/brightness 1
    write /sys/class/leds/charging/trigger breath_mode
    write /sys/class/leds/charging/tr1 1
    write /sys/class/leds/charging/tr2 1
    write /sys/class/leds/charging/ton 1
    write /sys/class/leds/charging/tf1 1
    write /sys/class/leds/charging/tf2 1
    write /sys/class/leds/charging/toff 1
on property:sys.kyoto.led=pulse_2
    write /sys/class/leds/charging/trigger none
    write /sys/class/leds/charging/brightness 2
    write /sys/class/leds/charging/trigger breath_mode
    write /sys/class/leds/charging/tr1 1
    write /sys/class/leds/charging/tr2 1
    write /sys/class/leds/charging/ton 1
    write /sys/class/leds/charging/tf1 1
    write /sys/class/leds/charging/tf2 1
    write /sys/class/leds/charging/toff 1
on property:sys.kyoto.led=pulse_3
