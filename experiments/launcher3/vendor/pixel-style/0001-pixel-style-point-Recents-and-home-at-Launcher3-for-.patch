From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yash Dayani <52958495+YashDayani@users.noreply.github.com>
Date: Sun, 18 Oct 2026 13:15:54 +0530
Subject: [PATCH] pixel-style: point Recents and home at Launcher3 for kyoto

kyoto replaces Pixel Launcher with Launcher3 QuickStep; recents, the
secondary home package and the setup wizard's gesture onboarding action
must name com.android.launcher3 or Recents and the end of setup break.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rro_overlays/PixelConfigOverlayCommon/res/values/config.xml | 4 ++--
 rro_overlays/PixelSetupWizardOverlay/res/values/strings.xml | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/rro_overlays/PixelConfigOverlayCommon/res/values/config.xml b/rro_overlays/PixelConfigOverlayCommon/res/values/config.xml
index 8959760..07aa956 100644
--- a/rro_overlays/PixelConfigOverlayCommon/res/values/config.xml
+++ b/rro_overlays/PixelConfigOverlayCommon/res/values/config.xml
@@ -363,7 +363,7 @@
          configuration uses Launcehr3QuickStep as default launcher and points to the corresponding
          recents component. When using a different default launcher, change this appropriately or
          use the default systemui implementation: com.android.systemui/.recents.RecentsActivity -->
-    <string name="config_recentsComponentName" translatable="false">com.google.android.apps.nexuslauncher/com.android.quickstep.RecentsActivity</string>
+    <string name="config_recentsComponentName" translatable="false">com.android.launcher3/com.android.quickstep.RecentsActivity</string>
 
     <!-- The package name for the default retail demo app.
          This package must be trusted, as it has the permissions to query the usage stats on the
@@ -383,7 +383,7 @@
          This launcher package must have an activity that supports multiple instances and has
          corresponding launch mode set in AndroidManifest.
          {@see android.view.Display#FLAG_SHOULD_SHOW_SYSTEM_DECORATIONS} -->
-    <string name="config_secondaryHomePackage" translatable="false">com.google.android.apps.nexuslauncher</string>
+    <string name="config_secondaryHomePackage" translatable="false">com.android.launcher3</string>
 
     <!-- Package name of the on-device intelligent processor for ambient audio.
          Ambient audio is the sound surrounding the device captured by the DSP
diff --git a/rro_overlays/PixelSetupWizardOverlay/res/values/strings.xml b/rro_overlays/PixelSetupWizardOverlay/res/values/strings.xml
index 91eac37..8c75795 100644
--- a/rro_overlays/PixelSetupWizardOverlay/res/values/strings.xml
+++ b/rro_overlays/PixelSetupWizardOverlay/res/values/strings.xml
@@ -7,6 +7,6 @@
     <string name="demo_device_admin_component_name">com.google.android.retaildemo/.DemoDeviceAdminReceiver</string>
     <string name="demo_device_admin_download_location">https://g.co/pixel/retaildemo</string>
     <string name="demo_device_admin_signature_checksum">ZUfHPe4VDBA5gL_f_lXMmgEdeF3WlKX5mv2CBbyvH4A</string>
-    <string name="exit_to_action_in_initial_setup">com.google.android.apps.nexuslauncher/com.android.quickstep.action.GESTURE_ONBOARDING_ALL_SET</string>
+    <string name="exit_to_action_in_initial_setup">com.android.launcher3/com.android.quickstep.action.GESTURE_ONBOARDING_ALL_SET</string>
     <string name="exit_to_action_in_deferred_setup">com.google.android.setupwizard/com.google.android.setupwizard.OPTIONAL_SETUP</string>
 </resources>
-- 
