+package com.android.systemui.qs;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Process-wide cache for the Settings.System values the QS customisations read while the
+ * shade is moving (QSAnimator.setPosition, QSImpl.setQsExpansion, slider paint/tint).
+ *
+ * Settings.System.getIntForUser(..., USER_CURRENT) is never served from the client-side
+ * NameValueCache (it only caches for myUserId()), so every read was a synchronous binder
+ * call into system_server, ~50 per shade pull. Values are kept here and dropped whenever
+ * any System setting changes or the foreground user switches.
+ */
+public final class QsSettingsCache {
+
+    private static final String NULL = new String("null");
+    private static final ConcurrentHashMap<String, String> sValues = new ConcurrentHashMap<>();
+    private static final AtomicInteger sGeneration = new AtomicInteger();
+    private static volatile boolean sRegistered;
+
+    private QsSettingsCache() {}
+
+    public static int getInt(Context context, String key, int def) {
+        String value = getString(context, key);
+        if (value == null) return def;
+        try {
+            return Integer.parseInt(value);
+        } catch (NumberFormatException e) {
+            return def;
+        }
+    }
+
+    public static String getString(Context context, String key) {
+        ensureRegistered(context);
+        String value = sValues.get(key);
+        if (value == null) {
+            int generation = sGeneration.get();
+            value = Settings.System.getStringForUser(context.getContentResolver(), key,
+                    UserHandle.USER_CURRENT);
+            // Only cache once the observer is live and nothing changed during the read.
+            if (sRegistered && generation == sGeneration.get()) {
+                sValues.put(key, value == null ? NULL : value);
+            }
+            return value;
+        }
+        return value == NULL ? null : value;
+    }
+
+    private static void invalidate() {
+        sGeneration.incrementAndGet();
+        sValues.clear();
+    }
+
+    private static void ensureRegistered(Context context) {
+        if (sRegistered) return;
+        synchronized (QsSettingsCache.class) {
+            if (sRegistered) return;
+            Context app = context.getApplicationContext();
+            if (app == null) app = context;
+            Handler handler = new Handler(Looper.getMainLooper());
+            try {
+                app.getContentResolver().registerContentObserver(Settings.System.CONTENT_URI,
+                        true /* notifyForDescendants */, new ContentObserver(handler) {
+                            @Override
+                            public void onChange(boolean selfChange, Uri uri) {
+                                invalidate();
+                            }
+                        }, UserHandle.USER_ALL);
+                app.registerReceiverForAllUsers(new BroadcastReceiver() {
+                    @Override
+                    public void onReceive(Context c, Intent intent) {
+                        invalidate();
+                    }
+                }, new IntentFilter(Intent.ACTION_USER_SWITCHED), null, handler);
+                sRegistered = true;
+            } catch (RuntimeException e) {
+                // No observer (e.g. a restricted context): keep reading uncached.
+            }
+        }
+    }
+}
