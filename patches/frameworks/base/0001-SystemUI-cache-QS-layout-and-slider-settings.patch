 .../com/android/systemui/qs/TileUtils.java    |  60 +++-------
 .../com/android/systemui/qs/VerticalSlider.kt |   4 +-
 3 files changed, 126 insertions(+), 46 deletions(-)
 create mode 100644 packages/SystemUI/src/com/android/systemui/qs/QsSettingsCache.java

